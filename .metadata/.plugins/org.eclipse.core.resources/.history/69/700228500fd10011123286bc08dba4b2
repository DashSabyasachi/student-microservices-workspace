spring.application.name=auth-service
server.port=9001

# ---- Eureka: register this service so others (the gateway) can find it by name ----
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.instance.prefer-ip-address=true

# ---- MySQL: this service owns its OWN database (users + logged-out tokens) ----
spring.datasource.url=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=pass123

# ---- JPA / Hibernate (creates users, blacklisted_tokens tables) ----
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ---- JWT ----
# Only auth-service knows this secret. Must be at least 32 characters.
jwt.secret=ChangeThisSecretKey_AtLeast32Characters_Long_123456
# Token validity: 1 hour
jwt.expiration-ms=3600000
